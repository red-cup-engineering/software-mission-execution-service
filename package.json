{
  "name": "@red-cup-engineering/software-mission-execution-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Market-coordinated software mission cell over immutable source, durable trajectory memory, isolated tools, and customer induction.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./customer-induction": "./src/customer-induction.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
  "bin": {
    "execute-software-mission-a2a-message": "./bin/execute-a2a-message.mjs",
    "serve-software-mission-a2a": "./bin/serve-a2a.mjs",
    "serve-software-mission-x402": "./bin/x402-server.mjs"
  },
  "scripts": {
    "check": "node --check src/client.mjs && node --check src/a2a-executor.mjs && node --check src/market-client.mjs && node --check src/activitypub-worker.mjs && node --check bin/execute-a2a-message.mjs && node --check bin/serve-a2a.mjs && node --check bin/x402-server.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.0",
    "@red-cup-engineering/activitypub-services-section": "1.0.0",
    "@red-cup-engineering/coding-context-projection-service": "1.0.0",
    "@red-cup-engineering/github-services-section": "1.0.0",
    "@harmonious-union/inference-work-lot-service": "4.0.0",
    "@red-cup-engineering/protected-acceptance-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2",
    "@red-cup-engineering/sandbox-command-execution-service": "1.0.0",
    "@red-cup-engineering/software-edit-language-service": "1.0.0",
    "@red-cup-engineering/software-trajectory-memory-service": "1.0.0",
    "@red-cup-engineering/x402-services-section": "1.2.0",
    "express": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "software-mission-execution-service",
    "actor": "urn:ame:software-mission-execution-service",
    "organizational-kind": "software-execution-provider",
    "owners": [
      "javascript-services-section"
    ],
    "admission": "one canonical RMN/CBOR SoftwareMissionExecutionRequest received through the hired A2A 1.0 provider",
    "refusal": "unbounded territory or tools, incomplete acceptance evidence, provider self-attestation, customer-border overwrite, noncanonical identity, or direct JSON/local-process customer invocation",
    "operation-catalog": {
      "execute-software-mission": {
        "contract": "content/contracts/software-mission-execution.rml",
        "protocols": [
          "RMN",
          "A2A 1.0",
          "RWIL/RDF"
        ],
        "returns": "SoftwareMissionExecutionResult|SoftwareMissionExecutionRefusal",
        "legacyCompatibility": false
      }
    },
    "x-foam-locus": {
      "address": [
        "software",
        "development",
        "mission",
        "execution"
      ],
      "proposition": "There exists a market-coordinated Actor which advances one durable software mission through context projection, provider procurement, receipt-bearing execution, protected verification, and resumable A2A custody.",
      "actor": "urn:ame:software-mission-execution-service",
      "projection": "content/foam/locus.json"
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "javascript-services-section",
    "kind": "capability-cell",
    "actor": "urn:ame:software-mission-execution-service",
    "operations": [
      "execute-software-mission"
    ],
    "capabilities": [
      {
        "capability": "software-mission-execution-service",
        "faces": [
          "execute-software-mission"
        ]
      }
    ],
    "package": "@red-cup-engineering/software-mission-execution-service"
  }
}
